{{- $installPackages := index . "installPackages" | default false -}}
{{- $workstation := index . "workstation" | default false -}}
{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

{{- if not $installPackages }}
echo "Automatic dependency management is disabled; shared configuration remains managed."
exit 0
{{- end }}

case "$(uname -m)" in
    x86_64|amd64) policy_target=darwin-x86_64 ;;
    arm64|aarch64) policy_target=darwin-aarch64 ;;
    *)
        echo "Dependency policy result: target-unsupported (darwin/$(uname -m))." >&2
        exit 1
        ;;
esac

policy_role={{ if $workstation }}workstation{{ else }}server{{ end }}
policy_package_family=homebrew
policy_font_dir="$HOME/Library/Fonts/JetBrainsMonoNerdFont"
policy_run_root() { "$@"; }

for command_name in curl tar unzip install shasum; do
    command -v "$command_name" >/dev/null 2>&1 || {
        echo "Required bootstrap command is missing: $command_name" >&2
        exit 1
    }
done

{{ includeTemplate "dependency-policy-posix.sh.tmpl" . }}
{{- end }}
