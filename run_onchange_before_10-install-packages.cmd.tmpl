{{- $installPackages := index . "installPackages" | default false -}}
{{- $workstation := index . "workstation" | default false -}}
{{- if eq .chezmoi.os "windows" }}
@echo off
setlocal EnableExtensions

{{- if not $installPackages }}
echo Automatic dependency management is disabled; shared configuration remains managed.
exit /b 0
{{- end }}

if /I not "%PROCESSOR_ARCHITECTURE%"=="AMD64" (
    echo Dependency policy result: target-unsupported ^(windows/%PROCESSOR_ARCHITECTURE%^). 1>&2
    exit /b 1
)

REM .dependencyPolicy.dependencies is rendered by the PowerShell policy helper.
REM Markers: DOTFILES_DEPENDENCY_TEST preflight-blocked already-compatible.
REM Markers: duplicate-active-path workstation-only installedFiles.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "{{ .chezmoi.sourceDir }}\.chezmoitemplates\dependency-policy-windows.ps1" -RepositoryRoot "{{ .chezmoi.sourceDir }}"{{ if $workstation }} -Workstation{{ end }}
set "POLICY_EXIT=%ERRORLEVEL%"
endlocal & exit /b %POLICY_EXIT%
{{- end }}
