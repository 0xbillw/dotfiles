{{- $installPackages := index . "installPackages" | default false -}}
{{- $workstation := index . "workstation" | default false -}}
{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

{{- if not $installPackages }}
echo "Automatic dependency management is disabled; shared configuration remains managed."
exit 0
{{- end }}

if [ ! -r /etc/os-release ]; then
    echo "Dependency policy result: target-unsupported (linux/unknown-distribution)." >&2
    exit 1
fi
. /etc/os-release

case "${ID:-}" in
    ubuntu) package_family=apt; libc_name=gnu ;;
    alpine) package_family=apk; libc_name=musl ;;
    fedora|rhel|centos|rocky|almalinux|alinux|anolis) package_family=dnf; libc_name=gnu ;;
    *)
        case " ${ID_LIKE:-} " in
            *" rhel "*|*" fedora "*|*" anolis "*) package_family=dnf; libc_name=gnu ;;
            *)
                echo "Dependency policy result: target-unsupported (${PRETTY_NAME:-${ID:-linux}})." >&2
                exit 1
                ;;
        esac
        ;;
esac

case "$(uname -m)" in
    x86_64|amd64) policy_arch=x86_64 ;;
    aarch64|arm64) policy_arch=aarch64 ;;
    *)
        echo "Dependency policy result: target-unsupported (linux/$(uname -m)/$libc_name)." >&2
        exit 1
        ;;
esac

policy_target="linux-${policy_arch}-${libc_name}"
policy_role={{ if $workstation }}workstation{{ else }}server{{ end }}
policy_package_family=$package_family
policy_font_dir="$HOME/.local/share/fonts/JetBrainsMonoNerdFont"

if [ "$(id -u)" -eq 0 ]; then
    policy_run_root() { "$@"; }
elif command -v sudo >/dev/null 2>&1; then
    policy_run_root() { sudo "$@"; }
else
    echo "Root access or sudo is required for native bootstrap packages." >&2
    exit 1
fi

case "$package_family" in
    apt)
        case "${VERSION_ID:-}" in 22.04|24.04) ;; *) echo "Dependency policy result: target-unsupported (ubuntu/${VERSION_ID:-unknown})." >&2; exit 1 ;; esac
        policy_run_root apt-get update
        policy_run_root apt-get install -y ca-certificates curl tar unzip xz-utils
{{- if $workstation }}
        policy_run_root apt-get install -y fontconfig
{{- end }}
        ;;
    dnf)
        command -v dnf >/dev/null 2>&1 || { echo "DNF family detected but dnf is unavailable." >&2; exit 1; }
        policy_run_root dnf install -y ca-certificates curl gzip tar unzip xz
{{- if $workstation }}
        policy_run_root dnf install -y fontconfig
{{- end }}
        ;;
    apk)
        command -v apk >/dev/null 2>&1 || { echo "Alpine detected but apk is unavailable." >&2; exit 1; }
        policy_run_root apk add --no-cache ca-certificates coreutils curl tar unzip xz
{{- if $workstation }}
        policy_run_root apk add --no-cache fontconfig
{{- end }}
        ;;
esac

{{ includeTemplate "dependency-policy-posix.sh.tmpl" . }}
{{- end }}
