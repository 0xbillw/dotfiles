{{- $installPackages := index . "installPackages" | default false -}}
{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

{{- if not $installPackages }}
echo "Automatic package installation is disabled; run 'chezmoi init --prompt' to change this machine option."
exit 0
{{- end }}

if [ ! -r /etc/os-release ]; then
    echo "Cannot identify this Linux distribution." >&2
    exit 1
fi

. /etc/os-release
if [ "${ID:-}" != "ubuntu" ]; then
    echo "Automatic Linux package installation currently supports Ubuntu 22.04 and 24.04 only." >&2
    exit 1
fi

case "${VERSION_ID:-}" in
    22.04|24.04) ;;
    *)
        echo "Unsupported Ubuntu release: ${VERSION_ID:-unknown}. Supported releases: 22.04 and 24.04." >&2
        exit 1
        ;;
esac

if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to install Ubuntu packages and repositories." >&2
    exit 1
fi

sudo apt-get update
sudo apt-get install -y ca-certificates curl fzf gnupg software-properties-common wget

# Nushell's official installation documentation provides this apt repository.
sudo install -d -m 0755 /etc/apt/keyrings
wget -qO- https://apt.fury.io/nushell/gpg.key \
    | sudo gpg --dearmor --yes -o /etc/apt/keyrings/fury-nushell.gpg
echo "deb [signed-by=/etc/apt/keyrings/fury-nushell.gpg] https://apt.fury.io/nushell/ /" \
    | sudo tee /etc/apt/sources.list.d/fury-nushell.list >/dev/null

# Helix documents this PPA for Ubuntu installations.
sudo add-apt-repository -y ppa:maveonair/helix-editor
sudo apt-get update
sudo apt-get install -y helix nushell

mkdir -p "$HOME/.local/bin"

# Install lightweight official release binaries for tools absent from Ubuntu LTS.
curl -fsSL https://starship.rs/install.sh \
    | sh -s -- --yes --bin-dir "$HOME/.local/bin"
curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh \
    | sh

case "$(uname -m)" in
    x86_64|amd64) zellij_target=x86_64-unknown-linux-musl ;;
    aarch64|arm64) zellij_target=aarch64-unknown-linux-musl ;;
    *)
        echo "Unsupported CPU architecture for Zellij: $(uname -m)" >&2
        exit 1
        ;;
esac

# Zellij 0.44.2/0.44.3 leak OSC replies on reattach; keep 0.44.1 for now.
curl -fsSL "https://github.com/zellij-org/zellij/releases/download/v0.44.1/zellij-${zellij_target}.tar.gz" \
    | tar -xz -C "$HOME/.local/bin" zellij

echo "Installed Ubuntu terminal dependencies without Homebrew."
{{- end }}
